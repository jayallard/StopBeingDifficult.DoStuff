<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sbd.DoStuff.Domain\Sbd.DoStuff.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Data\TaskLists\demo\release-checklist.yaml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Data\TaskLists\testing.yaml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="TailwindBuild" BeforeTargets="Build">
        <PropertyGroup>
            <TailwindCli Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\..\.tools\tailwindcss.exe</TailwindCli>
            <TailwindCli Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)../../.tools/tailwindcss</TailwindCli>
        </PropertyGroup>
        <Exec Command="&quot;$(TailwindCli)&quot; -i Styles/app.css -o wwwroot/app.css --minify"
              WorkingDirectory="$(MSBuildProjectDirectory)"
              Condition="Exists('$(TailwindCli)')" />
        <Warning Text="Tailwind CLI not found at '$(TailwindCli)' — skipping CSS build, app.css will not be regenerated. See README for setup."
                 Condition="!Exists('$(TailwindCli)')" />
    </Target>

</Project>
