<div class="ml-2 border-l border-slate-200 pl-3">
    <div class="flex items-center gap-2 py-1">
        @if (_renaming)
        {
            <input type="text" @ref="_renameInput"
                   class="w-64 rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-indigo-500 focus:outline-none"
                   @bind="_renameText" @bind:event="oninput"
                   @onkeydown="OnRenameKey"/>
            <button type="button" class="text-xs font-medium text-indigo-600 hover:text-indigo-500" @onclick="CommitRename">Save</button>
            <button type="button" class="text-xs text-slate-400 hover:text-slate-700" @onclick="() => _renaming = false">Cancel</button>
            @if (_renameError is not null)
            {
                <span class="text-xs text-red-600">@_renameError</span>
            }
        }
        else
        {
            <h3 class="font-medium text-slate-800">@Node.Segment</h3>
            <span class="text-xs text-slate-400">@Node.Path</span>
            <button type="button" class="text-xs text-slate-400 hover:text-slate-700" @onclick="StartRename">rename</button>
            <button type="button"
                    class="rounded border border-indigo-200 px-1.5 py-0.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50 disabled:cursor-not-allowed disabled:border-slate-200 disabled:text-slate-300 disabled:hover:bg-transparent"
                    disabled="@(SelectedTaskId is null)"
                    title="@(SelectedTaskId is null ? "Select a task above first" : $"Add '{SelectedTaskName}' to {Node.Path}")"
                    @onclick="() => OnAddSelected.InvokeAsync(Node.Path)">
                + Add
            </button>
        }
    </div>

    <div data-sortable data-path="@Node.Path"
         class="min-h-10 space-y-2 rounded-md border border-dashed border-slate-200 p-2 pb-2">
        @foreach (var entry in Node.Entries)
        {
            <EntryEditor @key="entry.Key" Entry="entry" Model="Model" CategoryPath="@Node.Path" OnChanged="OnChanged"/>
        }
    </div>

    <div class="mt-2 space-y-2">
        @foreach (var child in Node.Children.Values)
        {
            <EditorCategoryNode @key="child.Path" Node="child" Model="Model" OnChanged="OnChanged"
                                SelectedTaskId="@SelectedTaskId" SelectedTaskName="@SelectedTaskName" OnAddSelected="OnAddSelected"/>
        }
    </div>
</div>
