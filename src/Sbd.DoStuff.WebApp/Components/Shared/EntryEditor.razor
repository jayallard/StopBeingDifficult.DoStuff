@inject ITaskLibrary Library
@inject ITaskFactory TaskFactory
@inject ITaskExecutionEngine Engine

<div data-key="@Entry.Key" class="rounded-md border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center gap-2 px-3 py-2">
        <span class="drag-handle cursor-grab select-none px-1 text-slate-400 hover:text-slate-700" title="Drag to reorder or move to another category">⠿</span>

        <div class="min-w-0 flex-1">
            <button type="button" class="text-left text-sm font-medium text-slate-900 hover:text-indigo-700" @onclick="ToggleExpanded">
                @(_effective?.Name ?? Entry.TaskId)
            </button>
            <span class="ml-1 text-xs text-slate-400">@Entry.TaskId</span>
            @foreach (var category in Entry.Categories.Where(c => !string.Equals(c, CategoryPath, StringComparison.OrdinalIgnoreCase)))
            {
                <span class="ml-1 inline-flex items-center gap-1 rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">
                    also in @category
                    <button type="button" class="text-slate-400 hover:text-red-600" title="Remove from @category"
                            @onclick="() => RemoveFromCategory(category)">×</button>
                </span>
            }
            @if (_loadError is not null)
            {
                <span class="block text-xs text-red-600">@_loadError</span>
            }
            @if (!Entry.Expanded && !string.IsNullOrWhiteSpace(Entry.Notes))
            {
                <span class="block truncate text-xs italic text-slate-500" title="@Entry.Notes">@Entry.Notes</span>
            }
        </div>

        <button type="button"
                class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 hover:border-slate-400 hover:text-slate-900"
                @onclick="ToggleExpanded">
            @(Entry.Expanded ? "Hide" : "Edit")
        </button>
        <button type="button"
                class="rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-indigo-500"
                title="Run this task with the values shown, as it would run from the saved list"
                @onclick="Test">
            Test
        </button>
        <button type="button"
                class="rounded-md border border-red-200 bg-white px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50"
                title="@(Entry.Categories.Count > 1 ? $"Remove from {CategoryPath} only" : "Remove this task from the list")"
                @onclick="Remove">
            Remove
        </button>
    </div>

    @if (Entry.Expanded)
    {
        <div class="space-y-3 border-t border-slate-100 px-3 py-3">
            <div>
                <label class="text-sm font-medium text-slate-700" for="notes-@Entry.Key">
                    Notes <span class="text-xs font-normal text-slate-400">optional — why this task is in the list</span>
                </label>
                <textarea id="notes-@Entry.Key"
                          rows="2"
                          class="mt-1 w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm focus:border-indigo-500 focus:outline-none"
                          @bind="Entry.Notes"
                          @bind:event="onchange"></textarea>
            </div>

            @if (_effective is not null)
            {
                @if (_effective.Parameters.Count == 0)
                {
                    <p class="text-sm text-slate-500">This task has no parameters.</p>
                }

                @foreach (var parameter in _effective.Parameters)
                {
                    var locked = _effective.NonOverridableParameterNames.Contains(parameter.Name);
                    var value = CurrentValue(parameter);
                    <div>
                        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                            @parameter.Name
                            @if (parameter.Required)
                            {
                                <span class="text-xs font-normal text-red-500">required</span>
                            }
                            @if (locked)
                            {
                                <span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-normal text-amber-700">locked</span>
                            }
                            else if (Entry.Values.ContainsKey(parameter.Name))
                            {
                                <span class="rounded bg-indigo-100 px-1.5 py-0.5 text-xs font-normal text-indigo-700">overridden</span>
                                <button type="button" class="text-xs font-normal text-slate-400 hover:text-slate-700"
                                        @onclick="() => ResetValue(parameter)">reset</button>
                            }
                        </label>
                        @if (!string.IsNullOrWhiteSpace(parameter.Description))
                        {
                            <p class="text-xs text-slate-500">@parameter.Description</p>
                        }
                        @if (parameter.Type == TaskParameterType.MultilineText)
                        {
                            <textarea rows="6"
                                      class="@InputClass(locked, parameter, value) resize-y font-mono"
                                      disabled="@locked"
                                      readonly="@locked"
                                      @onchange="e => SetValue(parameter, e.Value?.ToString() ?? string.Empty)">@value</textarea>
                        }
                        else
                        {
                            <input type="text"
                                   class="@InputClass(locked, parameter, value)"
                                   value="@value"
                                   disabled="@locked"
                                   readonly="@locked"
                                   @onchange="e => SetValue(parameter, e.Value?.ToString() ?? string.Empty)"/>
                        }
                    </div>
                }
            }

            <div class="flex items-center gap-2">
                <CategorySelect Categories="Model.AllCategoryPaths" @bind-Value="_newCategory" Placeholder="Also file under…"
                                InputClass="w-56 rounded-md border border-slate-300 bg-white px-2 py-1 text-xs focus:border-indigo-500 focus:outline-none"/>
                <button type="button" class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 hover:border-slate-400"
                        @onclick="AddToCategory">
                    Add
                </button>
                @if (_categoryError is not null)
                {
                    <span class="text-xs text-red-600">@_categoryError</span>
                }
            </div>
        </div>
    }

    @if (Entry.TestError is not null || Entry.TestRun is not null)
    {
        <div class="border-t border-slate-100 px-3 py-3">
            @if (Entry.TestError is not null)
            {
                <p class="text-sm text-red-600">@Entry.TestError</p>
            }
            else if (Entry.TestRun is not null)
            {
                <div class="mb-2 flex items-center justify-between">
                    <span class="text-xs font-medium uppercase tracking-wide text-slate-400">Test run</span>
                    <div class="flex gap-2">
                        @if (Entry.TestRun.Status == TaskRunStatus.Running)
                        {
                            <button type="button" class="text-xs font-medium text-red-600 hover:text-red-500" @onclick="CancelTest">Cancel</button>
                        }
                        <button type="button" class="text-xs text-slate-400 hover:text-slate-700" @onclick="ClearTest">Dismiss</button>
                    </div>
                </div>
                <RunOutput @key="Entry.TestRun.RunId" Run="Entry.TestRun" ShowStatus="true"/>
            }
        </div>
    }
</div>
