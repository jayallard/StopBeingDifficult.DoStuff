@inject ITaskFactory TaskFactory
@inject ITaskExecutionEngine Engine
@inject NavigationManager Navigation

@if (string.IsNullOrEmpty(Node.Segment))
{
    <div class="space-y-2">
        @foreach (var child in Node.Children.Values.OrderBy(c => c.Segment))
        {
            <CategoryTreeNode Node="child" ListId="@ListId"/>
        }
    </div>
}
else
{
    <details class="ml-2 border-l border-slate-200 pl-3" open>
        <summary class="cursor-pointer select-none font-medium text-slate-800 hover:text-indigo-700">@Node.Segment</summary>

        <div class="mt-2 space-y-2 pb-2">
            @foreach (var child in Node.Children.Values.OrderBy(c => c.Segment))
            {
                <CategoryTreeNode Node="child" ListId="@ListId"/>
            }

            @foreach (var task in Node.Tasks)
            {
                <div class="flex items-center justify-between rounded border border-slate-200 bg-white px-3 py-2 transition hover:border-indigo-300">
                    <div>
                        <a href="@($"lists/{ListId}/tasks/{task.Definition.Id}")" class="text-slate-900 hover:text-indigo-700 hover:underline">
                            @task.Definition.Name
                        </a>
                        @if (task.ParameterValues.Count > 0)
                        {
                            <div class="mt-1 flex flex-wrap gap-1.5">
                                @foreach (var (name, value) in task.ParameterValues)
                                {
                                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">@name: @value</span>
                                }
                            </div>
                        }
                    </div>
                    <button type="button"
                            class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-indigo-500"
                            @onclick="() => Run(task)">
                        Run
                    </button>
                </div>
            }
        </div>
    </details>
}
