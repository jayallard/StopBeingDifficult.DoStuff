@inject ITaskFactory TaskFactory
@inject ITaskExecutionEngine Engine
@inject ITaskRunStore RunStore
@inject NavigationManager Navigation
@inject ITaskListRepository ListRepository
@inject ITaskLibrary Library

@if (string.IsNullOrEmpty(Node.Segment))
{
    <div class="space-y-2">
        @foreach (var child in Node.Children.Values)
        {
            <CategoryTreeNode Node="child" ListId="@ListId" OnSaved="OnSaved"/>
        }
    </div>
}
else
{
    <details id="@CategoryAnchor.Id(Node.FullPath)" class="ml-2 scroll-mt-4 border-l border-slate-200 pl-3" open>
        <summary class="flex cursor-pointer select-none items-center justify-between font-medium text-slate-800 hover:text-indigo-700">
            <span>@Node.Segment</span>
            <button type="button"
                    title="Reset all tasks in this category and its subcategories"
                    class="rounded-md border border-slate-300 bg-white px-2 py-0.5 text-xs font-medium text-slate-600 transition hover:border-slate-400 hover:text-slate-900"
                    @onclick="ResetCategory" @onclick:preventDefault @onclick:stopPropagation>
                Reset
            </button>
        </summary>

        <div class="mt-2 space-y-2 pb-2">
            @foreach (var child in Node.Children.Values)
            {
                <CategoryTreeNode Node="child" ListId="@ListId" OnSaved="OnSaved"/>
            }

            @for (var i = 0; i < Node.Tasks.Count; i++)
            {
                var task = Node.Tasks[i];
                if (ReferenceEquals(task, _editingView) && _editing is not null)
                {
                    <div id="@CategoryAnchor.TaskId(Node.FullPath, i)" class="scroll-mt-4 rounded border border-indigo-300 bg-white px-3 py-3">
                        <p class="mb-2 text-sm font-medium text-slate-900">@task.Definition.Name</p>
                        <EntryFieldsEditor Entry="_editing" Effective="task.Definition"/>
                        @if (_editError is not null)
                        {
                            <p class="mt-2 text-sm text-red-600">@_editError</p>
                        }
                        <div class="mt-3 flex justify-end gap-2">
                            <button type="button"
                                    class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:border-slate-400 hover:text-slate-900"
                                    @onclick="CancelEdit">
                                Cancel
                            </button>
                            <button type="button"
                                    class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500"
                                    @onclick="SaveEdit">
                                Save
                            </button>
                        </div>
                    </div>
                    continue;
                }

                <div id="@CategoryAnchor.TaskId(Node.FullPath, i)" class="@(RowClass(task) + " scroll-mt-4")">
                    <div>
                        <a href="@($"lists/{ListId}/tasks/{task.Definition.Id}")" class="text-slate-900 hover:text-indigo-700 hover:underline">
                            @(task.Name ?? task.Definition.Name)
                        </a>
                        @if (!string.IsNullOrWhiteSpace(task.Notes))
                        {
                            <p class="mt-0.5 whitespace-pre-line text-sm text-slate-500">@task.Notes</p>
                        }
                        @if (_runErrors.TryGetValue(task.Definition.Id, out var runError))
                        {
                            <p class="mt-0.5 text-sm text-red-600">@runError</p>
                        }
                        @if (task.ParameterValues.Count > 0)
                        {
                            <div class="mt-1 flex flex-wrap gap-1.5">
                                @foreach (var (name, value) in task.ParameterValues)
                                {
                                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">@name: <ParameterValueText Type="task.Definition.Parameters.FirstOrDefault(p => p.Name == name)?.Type ?? TaskParameterType.Text" Value="@value"/></span>
                                }
                            </div>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        @if (task.Source is not null)
                        {
                            <button type="button"
                                    class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 hover:text-slate-900"
                                    @onclick="() => StartEdit(task)">
                                Edit
                            </button>
                        }
                        <button type="button"
                                class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-indigo-500"
                                @onclick="() => Run(task)">
                            Run
                        </button>
                    </div>
                </div>
            }
        </div>
    </details>
}
