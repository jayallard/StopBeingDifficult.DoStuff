@implements IAsyncDisposable
@inject ITaskExecutionEngine Engine
@inject IJSRuntime JS

@if (ShowStatus)
{
    <p class="mb-2 text-sm text-slate-500">Status: <span class="@StatusClass(Run.Status)">@Run.Status</span></p>
}

@if (Run.ResultCode is not null)
{
    <div class="@ResultBadgeClass(Run.ResultCode.Value) mb-4 rounded-md px-3 py-2 text-sm">
        @Run.ResultCode: @Run.ResultMessage
    </div>
}

@if (MessageLines.Any())
{
    <div class="mb-4 space-y-1 rounded-lg border border-slate-200 bg-white p-3">
        @foreach (var line in MessageLines)
        {
            <div class="text-sm @(line.Text.StartsWith('!') ? "text-red-600 font-medium" : "text-slate-700")">@line.Text[1..]</div>
        }
    </div>
}

<div class="mb-1 flex justify-end">
    <button type="button"
            title="Copy output to clipboard"
            class="inline-flex items-center gap-1 rounded px-2 py-1 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
            @onclick="CopyOutput">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        @(_copied ? "Copied" : "Copy")
    </button>
</div>

<pre @ref="_output" class="max-h-[32rem] overflow-y-auto rounded-lg border border-slate-800 bg-slate-950 p-4 font-mono text-sm leading-6 shadow-inner">@foreach (var line in Run.OutputLines)
{<div class="@LineClass(line)">@LineText(line)</div>}</pre>
