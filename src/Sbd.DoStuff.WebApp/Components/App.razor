<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <script>
        // Applied before first paint so a saved dark theme doesn't flash light.
        (function () {
            var dark = false;
            try {
                var saved = localStorage.getItem('theme');
                dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
            } catch (e) { }
            document.documentElement.classList.toggle('dark', dark);
        })();
        function toggleTheme() {
            var dark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) { }
        }
        // After a server restart the Blazor circuit is gone: wait for the server to go down and come
        // back, then reload so the page gets a fresh circuit.
        function reloadWhenServerRestarts() {
            var sawDown = false;
            var timer = setInterval(function () {
                fetch('/', { cache: 'no-store' }).then(function (r) {
                    if (sawDown && r.ok) { clearInterval(timer); location.reload(); }
                }).catch(function () { sawDown = true; });
            }, 500);
        }
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Sbd.DoStuff.WebApp.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<script src="lib/sortablejs/Sortable.min.js"></script>
<script src="_framework/blazor.web.js"></script>
</body>

</html>