@page "/lists/new"
@page "/lists/{ListId}/edit"
@implements IAsyncDisposable
@inject ITaskListRepository ListRepository
@inject ITaskLibrary Library
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "New task list" : $"Edit {_model.Name}")</PageTitle>

@if (_notFound)
{
    <p class="text-slate-500">List not found.</p>
}
else
{
    var tree = _model.BuildTree();

    <h1 class="mb-4 text-2xl font-semibold text-slate-900">@(IsNew ? "New task list" : "Edit task list")</h1>

    <div class="mb-6 space-y-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium text-slate-700">
                Name
                <input type="text" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none"
                       @bind="_model.Name" @bind:event="oninput"/>
            </label>
            <label class="block text-sm font-medium text-slate-700">
                Id
                <input type="text" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm focus:border-indigo-500 focus:outline-none"
                       placeholder="@Slug(_model.Name)"
                       @bind="_model.Id" @bind:event="oninput"/>
            </label>
        </div>

        <label class="block text-sm font-medium text-slate-700">
            Description
            <input type="text" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none"
                   @bind="_model.Description" @bind:event="oninput"/>
        </label>

        <fieldset>
            <legend class="text-sm font-medium text-slate-700">Storage</legend>
            <div class="mt-1 flex flex-col gap-2 sm:flex-row sm:gap-6">
                <label class="flex items-center gap-2 text-sm text-slate-700">
                    <input type="radio" name="scope" checked="@(_model.Scope == TaskListScope.Private)"
                           @onchange="() => _model.Scope = TaskListScope.Private"/>
                    Private <span class="text-slate-400">— your profile folder, only on this machine</span>
                </label>
                <label class="flex items-center gap-2 text-sm text-slate-700">
                    <input type="radio" name="scope" checked="@(_model.Scope == TaskListScope.Public)"
                           @onchange="() => _model.Scope = TaskListScope.Public"/>
                    Public <span class="text-slate-400">— the data folder, shared through source control</span>
                </label>
            </div>
        </fieldset>
    </div>

    <div class="sticky top-0 z-30 -mx-4 mb-4 bg-slate-50 px-4 pb-2 pt-3 sm:-mx-8 sm:px-8 lg:-mx-10 lg:px-10">
            <h2 class="mb-2 font-medium text-slate-800">Tasks</h2>
        <div class="flex flex-col gap-2 rounded-lg border border-slate-200 bg-white p-3 shadow-sm sm:flex-row sm:items-start">
            <div class="flex-1">
                <TaskPicker OnPicked="AddTask"/>
                @if (_selectedTaskId is not null)
                {
                    <p class="mt-2 text-xs text-slate-500">
                        Selected: <span class="font-medium text-slate-800">@SelectedTaskName</span>
                        — click <span class="font-medium text-indigo-600">+ Add</span> on a category below.
                        <button type="button" class="ml-1 text-slate-400 hover:text-slate-700" @onclick="() => _selectedTaskId = null">clear</button>
                    </p>
                }
            </div>
            <div class="sm:w-64"><CategorySelect Categories="_model.AllCategoryPaths" @bind-Value="_pickCategory" Placeholder="Select category…"/></div>
        </div>
    </div>

    <div class="mb-4 flex items-center gap-2">
        <input type="text" placeholder="New empty category…"
               class="w-64 rounded-md border border-slate-300 px-2 py-1.5 text-sm focus:border-indigo-500 focus:outline-none"
               @bind="_newCategory" @bind:event="oninput"
               @onkeydown="OnNewCategoryKey"/>
        <button type="button" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:border-slate-400"
                @onclick="AddCategory">
            Add category
        </button>
    </div>

    <div @ref="_treeRoot" class="mb-6 space-y-3"
         @ondragover:preventDefault="@(_model.DraggedCategory is not null)"
         @ondragover="() => { }"
         @ondrop="OnDropTopLevel" @ondrop:preventDefault>
        @foreach (var child in tree.Children.Values)
        {
            <EditorCategoryNode @key="child.Path" Node="child" Model="_model" OnChanged="StateHasChanged"
                                SelectedTaskId="@_selectedTaskId" SelectedTaskName="@SelectedTaskName" OnAddSelected="AddSelectedTo"/>
        }
        @if (tree.Children.Count == 0)
        {
            <p class="text-sm text-slate-500">No tasks yet. Search above to add one.</p>
        }
    </div>

    @if (_errors.Count > 0)
    {
        <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            <ul class="list-disc pl-5">
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="flex items-center gap-3 border-t border-slate-200 pt-4">
        <button type="button" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" @onclick="Save">
            Save
        </button>
        <a href="@CancelHref" class="text-sm font-medium text-slate-500 hover:text-slate-900">Cancel</a>
    </div>
}
