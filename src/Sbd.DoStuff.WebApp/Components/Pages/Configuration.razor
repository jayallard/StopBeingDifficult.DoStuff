@page "/configuration"
@inject IEnumerable<IDataSource> DataSources
@inject Sbd.DoStuff.WebApp.Services.AppRestarter Restarter
@inject IJSRuntime JS

<PageTitle>Configuration</PageTitle>

<div class="mb-1 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-semibold text-slate-900">Configuration</h1>
    @if (_restarting)
    {
        <span class="text-sm text-slate-500">Restarting&hellip;</span>
    }
    else if (_confirmRestart)
    {
        <div class="flex items-center gap-2 text-sm">
            <span class="text-slate-500">Stops running tasks and reloads the app.</span>
            <button type="button" @onclick="RestartAsync"
                    class="rounded-md bg-indigo-600 px-3 py-1.5 font-medium text-white hover:bg-indigo-700">Restart</button>
            <button type="button" @onclick="() => _confirmRestart = false"
                    class="rounded-md px-3 py-1.5 text-slate-600 hover:bg-slate-100">Cancel</button>
        </div>
    }
    else
    {
        <button type="button" @onclick="() => _confirmRestart = true"
                title="Restart the app so it picks up new environment variables"
                class="rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100">
            Restart app
        </button>
    }
</div>
<p class="mb-6 text-sm text-slate-500">
    Where the task library, task lists and assets come from. Sources are listed in load order;
    new public lists are saved to the first, private lists to the last.
    The first source is the <strong>system</strong> folder: it ships with the app, so anything may rely on it.
    Task definitions can inherit only from the system folder or their own folder.
</p>

<div class="space-y-8">
    @foreach (var (source, index) in DataSources.Select((s, i) => (s, i)))
    {
        var items = source.GetItems();

        <section id="@SourceAnchor(index)">
            <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-slate-500">@source.Type</span>
                @if (index == 0)
                {
                    <span class="rounded bg-indigo-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-indigo-700"
                          title="Delivered with the app and available to every install. Tasks may inherit from here, or from their own folder, but not from other folders.">System</span>
                }
                <h2 class="break-all font-mono text-sm text-slate-900">@source.Location</h2>
            </div>

            @if (items.Count == 0)
            {
                <p class="text-sm text-slate-400">Nothing found here.</p>
            }

            @foreach (var group in items.GroupBy(i => i.Kind))
            {
                <h3 id="@KindAnchor(index, group.Key)" class="mb-1 mt-4 text-xs font-medium uppercase tracking-wide text-slate-400">
                    @KindTitle(group.Key) <span class="normal-case">(@group.Count())</span>
                </h3>
                <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
                    <table class="w-full text-left text-sm">
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var item in group)
                            {
                                <tr>
                                    <td class="px-3 py-2 align-top">
                                        <a href="@($"configuration/file?path={Uri.EscapeDataString(item.Location)}")"
                                           class="break-all font-mono text-slate-800 hover:text-indigo-700" title="@item.Location">@item.Name</a>
                                        @if (item.Provides.Count > 0)
                                        {
                                            <div class="mt-0.5 text-xs text-slate-500">@ProvidesSummary(item)</div>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-2 text-right align-top text-xs text-slate-400">
                                        @FormatSize(item.SizeBytes)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>
