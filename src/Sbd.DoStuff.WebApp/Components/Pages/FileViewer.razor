@page "/configuration/file"
@inject IEnumerable<IDataSource> DataSources

<PageTitle>@(_item?.Name ?? "File") - Configuration</PageTitle>

<a href="configuration" class="text-sm text-indigo-600 hover:text-indigo-500">&larr; Configuration</a>

@if (_item is null || _text is null)
{
    <h1 class="mt-3 text-2xl font-semibold text-slate-900">File not found</h1>
    <p class="mt-1 text-sm text-slate-500">That file isn't provided by any configured data source.</p>
}
else
{
    <h1 class="mt-3 break-all font-mono text-lg font-semibold text-slate-900">@_item.Name</h1>
    <p class="mt-1 break-all text-xs text-slate-400">@_item.Location</p>
    <p class="mb-4 mt-2 flex flex-wrap gap-x-3 text-xs text-slate-500">
        <span class="rounded bg-slate-100 px-2 py-0.5">@(_language ?? "Plain text")</span>
        <span>@_lineCount lines</span>
        <span>@FormatSize(_item.SizeBytes)</span>
    </p>

    <pre class="overflow-x-auto rounded-lg border border-slate-200 bg-white p-4 text-sm leading-relaxed text-slate-800"><code>@((MarkupString)_html!)</code></pre>
}
