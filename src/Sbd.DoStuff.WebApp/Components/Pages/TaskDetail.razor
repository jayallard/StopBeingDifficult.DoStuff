@page "/lists/{ListId}/tasks/{TaskId}"
@inject ITaskListRepository ListRepository
@inject ITaskLibrary Library
@inject ITaskRunStore RunStore
@inject ITaskFactory TaskFactory
@inject ITaskExecutionEngine Engine
@inject NavigationManager Navigation

<PageTitle>@(_definition?.Name ?? "Task not found")</PageTitle>

@if (_list is null || _definition is null)
{
    <p class="text-slate-500">Task not found.</p>
}
else
{
    <h1 class="mb-1 text-2xl font-semibold text-slate-900">@_definition.Name</h1>
    @if (!string.IsNullOrWhiteSpace(_definition.Description))
    {
        <p class="mb-4 text-slate-500">@_definition.Description</p>
    }

    <h2 class="mb-2 text-sm font-medium uppercase tracking-wide text-slate-500">
        In this list
    </h2>
    <div class="mb-6 space-y-2">
        @foreach (var entry in _entries)
        {
            <div class="flex items-center justify-between rounded border border-slate-200 bg-white px-3 py-2">
                <div>
                    <div class="text-sm text-slate-500">@string.Join(", ", entry.Entry.Categories)</div>
                    @if (entry.View.ParameterValues.Count > 0)
                    {
                        <dl class="mt-2 space-y-1">
                            @foreach (var (name, value) in entry.View.ParameterValues)
                            {
                                <div class="flex items-baseline gap-2 text-xs">
                                    <dt class="font-medium text-slate-500">@name</dt>
                                    <dd class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700">@value</dd>
                                </div>
                            }
                        </dl>
                    }
                </div>
                <button type="button"
                        class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-indigo-500"
                        @onclick="() => Run(entry.View)">
                    Run
                </button>
            </div>
        }
    </div>

    <h2 class="mb-2 text-sm font-medium uppercase tracking-wide text-slate-500">
        Recent runs
    </h2>
    <div class="space-y-1">
        @foreach (var run in RunStore.GetRecentForTask(ListId, TaskId))
        {
            <a href="@($"lists/{ListId}/tasks/{TaskId}/runs/{run.RunId}")"
               class="flex items-center justify-between rounded border border-slate-200 bg-white px-3 py-2 transition hover:border-indigo-300 hover:bg-indigo-50/40">
                <span class="text-sm text-slate-500">@run.StartedAt.LocalDateTime</span>
                <span class="text-sm font-medium">@run.Status</span>
            </a>
        }
    </div>
}
