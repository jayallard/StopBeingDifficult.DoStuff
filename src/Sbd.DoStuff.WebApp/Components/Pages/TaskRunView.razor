@page "/lists/{ListId}/tasks/{TaskId}/runs/{RunId:guid}"
@implements IDisposable
@inject ITaskRunStore RunStore
@inject ITaskExecutionEngine Engine

<PageTitle>@(_run?.TaskName ?? "Run not found")</PageTitle>

@if (_run is null)
{
    <p class="text-slate-500">Run not found.</p>
}
else
{
    <div class="mb-4 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">@_run.TaskName</h1>
            <p class="text-sm text-slate-500">Status: <span class="@StatusClass(_run.Status)">@_run.Status</span></p>
        </div>

        @if (_run.Status == TaskRunStatus.Running)
        {
            <button type="button"
                    class="rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-red-500"
                    @onclick="Cancel">
                Cancel
            </button>
        }
    </div>

    @if (_run.ResultCode is not null)
    {
        <div class="@ResultBadgeClass(_run.ResultCode.Value) mb-4 rounded-md px-3 py-2 text-sm">
            @_run.ResultCode: @_run.ResultMessage
        </div>
    }

    <pre class="max-h-[32rem] overflow-y-auto rounded-lg border border-slate-800 bg-slate-950 p-4 font-mono text-sm leading-6 shadow-inner">@foreach (var line in _run.OutputLines)
{<div class="@LineClass(line.Stream)">@line.Text</div>}</pre>
}
