@page "/lists/{ListId}/tasks/{TaskId}/runs/{RunId:guid}"
@implements IDisposable
@inject ITaskRunStore RunStore
@inject ITaskExecutionEngine Engine
@inject ITaskLibrary Library
@inject ITaskListRepository ListRepository

<PageTitle>@DisplayName</PageTitle>

@if (_run is null)
{
    <p class="text-slate-500">Run not found.</p>
}
else
{
    <div class="mb-4 flex items-start justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">@DisplayName</h1>
            <p class="text-sm text-slate-500">Status: <span class="@RunOutput.StatusClass(_run.Status)">@_run.Status</span></p>
        </div>

        <div class="flex flex-col items-end gap-2">
            <a href="@BackHref"
               class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 transition hover:text-slate-900">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Back
            </a>

            @if (_run.Status == TaskRunStatus.Running)
            {
                <button type="button"
                        class="rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-red-500"
                        @onclick="Cancel">
                    Cancel
                </button>
            }
        </div>
    </div>

    @if (_entry is not null)
    {
        var def = _entry.Definition;
        <section class="mb-4 rounded border border-slate-200 bg-white px-3 py-2">
            @if (!string.IsNullOrWhiteSpace(def.Description))
            {
                <p class="mb-2 text-sm text-slate-600">@def.Description</p>
            }
            @if (!string.IsNullOrWhiteSpace(_entry.Notes))
            {
                <p class="mb-2 whitespace-pre-line text-sm text-slate-600">@_entry.Notes</p>
            }
            <dl class="space-y-1">
                <div class="flex items-baseline gap-2 text-xs">
                    <dt class="font-medium text-slate-500">Task</dt>
                    <dd class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700">@def.Name (@def.Id)</dd>
                </div>
                <div class="flex items-baseline gap-2 text-xs">
                    <dt class="font-medium text-slate-500">Type</dt>
                    <dd class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700">@def.Type</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(def.ScriptPath))
                {
                    <div class="flex items-baseline gap-2 text-xs">
                        <dt class="font-medium text-slate-500">Script</dt>
                        <dd class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700">@def.ScriptPath</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(def.WorkingDirectory))
                {
                    <div class="flex items-baseline gap-2 text-xs">
                        <dt class="font-medium text-slate-500">Working directory</dt>
                        <dd class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-700">@def.WorkingDirectory</dd>
                    </div>
                }
                @foreach (var (name, value) in _entry.ParameterValues)
                {
                    <div class="flex items-baseline gap-2 text-xs">
                        <dt class="font-medium text-slate-500">@name</dt>
                        <dd class="whitespace-pre-wrap rounded bg-slate-100 px-1.5 py-0.5 text-slate-700">@value</dd>
                    </div>
                }
            </dl>
        </section>
    }

    <RunOutput Run="_run"/>
}
