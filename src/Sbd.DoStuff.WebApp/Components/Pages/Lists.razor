@page "/"
@inject ITaskListRepository ListRepository

<PageTitle>Task Lists</PageTitle>

<div class="mb-6 flex items-start justify-between">
    <div>
        <h1 class="mb-1 text-2xl font-semibold text-slate-900">Task Lists</h1>
        <p class="text-sm text-slate-500">Pick a list to see its tasks.</p>
    </div>
    <a href="lists/new"
       class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-indigo-500">
        New list
    </a>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var list in ListRepository.GetAll())
    {
        <div class="flex flex-col rounded-lg border border-slate-200 bg-white shadow-sm transition hover:border-indigo-300 hover:shadow-md">
            @if (_renamingId == list.Id)
            {
                <div class="p-4">
                    <input type="text"
                           class="w-full rounded-md border border-slate-300 px-2 py-1 text-sm"
                           @bind="_renameValue" @bind:event="oninput"
                           @onkeydown="e => OnRenameKey(e, list)" />
                    @if (_error is not null)
                    {
                        <p class="mt-1 text-xs text-red-600">@_error</p>
                    }
                </div>
                <div class="mt-auto flex items-center gap-2 border-t border-slate-100 px-4 py-2">
                    <button type="button" class="rounded bg-indigo-600 px-2 py-0.5 text-xs font-medium text-white hover:bg-indigo-500"
                            @onclick="() => Rename(list)">Save</button>
                    <button type="button" class="text-xs text-slate-400 hover:text-slate-700"
                            @onclick="CancelRename">Cancel</button>
                </div>
            }
            else
            {
                <a href="@($"lists/{list.Id}")" class="block flex-1 p-4">
                    <h2 class="font-medium text-slate-900">@list.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(list.Description))
                    {
                        <p class="mt-1 text-sm text-slate-500">@list.Description</p>
                    }
                </a>
                <div class="flex items-center gap-3 border-t border-slate-100 px-4 py-2">
                    @if (_confirmDeleteId == list.Id)
                    {
                        <span class="text-xs text-slate-500">Delete this list?</span>
                        <button type="button" class="rounded bg-red-600 px-2 py-0.5 text-xs font-medium text-white hover:bg-red-500"
                                @onclick="() => Delete(list)">Delete</button>
                        <button type="button" class="text-xs text-slate-400 hover:text-slate-700"
                                @onclick="() => _confirmDeleteId = null">No</button>
                    }
                    else
                    {
                        <button type="button" class="text-xs text-slate-500 hover:text-indigo-600"
                                @onclick="() => StartRename(list)">Rename</button>
                        <button type="button" class="text-xs text-slate-500 hover:text-red-600"
                                @onclick="() => StartDelete(list)">Delete</button>
                    }
                </div>
            }
        </div>
    }
</div>
