@page "/library/new"
@inject ITaskLibrary Library
@inject NavigationManager Navigation

<PageTitle>New task library</PageTitle>

<h1 class="mb-4 text-2xl font-semibold text-slate-900">New task library</h1>

<div class="mb-6 space-y-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
    <label class="block text-sm font-medium text-slate-700">
        Name
        <input type="text" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none"
               placeholder="e.g. git-library"
               @bind="_name" @bind:event="oninput"/>
        <span class="mt-1 block text-xs font-normal text-slate-500">
            Saved as <span class="font-mono">@(Slug(_name).Length == 0 ? "<name>" : Slug(_name)).yaml</span>
        </span>
    </label>

    <label class="block text-sm font-medium text-slate-700">
        Save in folder
        <select class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none"
                @bind="_storageDirectory">
            @foreach (var directory in Library.StorageDirectories)
            {
                <option value="@directory">@DirectoryLabel(directory)</option>
            }
        </select>
    </label>
</div>

@if (_error is not null)
{
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">@_error</div>
}

<div class="flex items-center gap-3 border-t border-slate-200 pt-4">
    <button type="button" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" @onclick="Create">
        Create
    </button>
    <a href="library" class="text-sm font-medium text-slate-500 hover:text-slate-900">Cancel</a>
</div>
